<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LiveDemo.exe: double-click to run scripts/live-demo.ps1 (see Program.cs). Not part of the solution.
    Build it on the PC that runs the live demo; the exe remembers this checkout's folder:
      dotnet publish scripts/LiveDemoLauncher -o publish/live-demo
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LiveDemo</AssemblyName>
    <ApplicationIcon>..\..\src\ReceiptExtractor.Api\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
  </ItemGroup>

</Project>
